# Copy to .env and adjust as needed. All three have working defaults —
# .env is optional for local dev.

# Ollama server Homebase talks to for chat + embedding models.
OLLAMA_BASE_URL=http://localhost:11434/api

# Default embedding model for /embed and RAG (/kb/*). Must be pulled locally
# first: `ollama pull nomic-embed-text`. See docs/embeddings.md.
EMBEDDING_MODEL=nomic-embed-text

# Port Homebase's HTTP server listens on.
PORT=3000
