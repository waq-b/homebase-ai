# Copy to .env and adjust as needed. .env is optional for local dev.

# Ollama server Homebase talks to for chat models. Defaults to Ollama Cloud
# (hosted, free tier). Set to http://localhost:11434/api to use a local Ollama.
OLLAMA_BASE_URL=https://ollama.com/api

# Required when OLLAMA_BASE_URL points at Ollama Cloud (the default above).
# Get one at https://ollama.com/settings/keys. Not needed for a local install.
OLLAMA_API_KEY=

# Required for /embed and RAG /kb/*: embeddings go through Voyage AI, not
# Ollama (Ollama Cloud doesn't serve embedding models). Get a key at
# https://dash.voyageai.com. See docs/embeddings.md.
VOYAGE_API_KEY=

# Default embedding model for /embed and RAG (/kb/*). voyage-4-lite is the
# cheapest/fastest tier ($0.02/M tokens); see docs/embeddings.md for others.
EMBEDDING_MODEL=voyage-4-lite

# Port Homebase's HTTP server listens on.
PORT=3000

# API key for agents using `provider: openrouter`, and for the automatic
# fallback (see OPENROUTER_FALLBACK_MODEL below) any `provider: ollama` agent
# uses if its primary (Ollama Cloud) call fails. Get one at
# https://openrouter.ai/keys — the free tier ($0, no card) works fine here.
OPENROUTER_API_KEY=

# Free OpenRouter model used as the automatic fallback for `provider: ollama`
# agents. Only engaged when OPENROUTER_API_KEY is set.
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b:free

# When set, all routes (except /health) require `Authorization: Bearer <key>`.
# Leave unset for local dev. Set it if the server is reachable from other
# machines (see docs/remote-access.md).
HOMEBASE_API_KEY=
