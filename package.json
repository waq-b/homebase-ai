{
  "name": "homebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "mcp:demo": "tsx watch mcp-servers/demo-time/server.ts",
    "test": "vitest run --exclude \"homebase-client/**\"",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"homebase-client/**\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scalar/hono-api-reference": "^0.11.13",
    "ai": "^4.3.19",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "ollama-ai-provider": "^1.2.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
